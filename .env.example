DATABASE_URL=postgresql+psycopg://cvuser:replace-with-a-strong-password@postgres:5432/cvapp

BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
BACKEND_URL=http://backend:8000
BACKEND_USER_EMAIL=
BACKEND_USER_PASSWORD=
AWS_ACCESS_KEY_ID=replace-with-new-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-new-aws-secret-key
# AWS_SESSION_TOKEN=only-required-for-temporary-credentials
AGENT_MODEL_NAME=satellite-cv-agent
AGENT_PORT=8010

# Langfuse LLM observability (choose the base URL matching your project region)
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_BASE_URL=https://cloud.langfuse.com


MODEL_PATH=/app/models/model.onnx
MODEL_NAME=ResNet50V2
MODEL_VERSION=1.0.0
MAX_UPLOAD_MB=10
AUTH_SECRET=replace-with-a-long-random-auth-secret
ACCESS_TOKEN_HOURS=24
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=redis://redis:6379/0
INFERENCE_CACHE_SECONDS=3600
CORS_ORIGINS=http://localhost:3000

# Optional S3-compatible image storage
STORE_IMAGES=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

FRONTEND_PORT=3000
BACKEND_PORT=8000
OPEN_WEBUI_PORT=8080

WEBUI_SECRET_KEY=replace-with-a-long-random-secret
ENABLE_SIGNUP=true
ENABLE_AUDIO_TRANSCRIPTION=true
AUDIO_STT_ENGINE=web_api
AUDIO_TTS_ENGINE=web_api
